  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide": "^0.468.0",
    "page-flip": "^2.0.7",
    "solid-js": "1.9.17",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "linkedom": "^0.18.14",
    "playwright": "1.64.1",
    "smol-toml": "^1.9.1",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "5.9.3",
